# ═══════════════════════════════════════════════════════════
# .htaccess · rostur.expert · Jino (Apache) · v6 STABLE · 2026-10-09
# Минимум rewrite-правил: только https, www и старые URL.
# Слеши у папок добавляет сам Apache (mod_dir) — без петель.
# ═══════════════════════════════════════════════════════════

RewriteEngine On
DirectoryIndex index.html

# ─── 1. HTTP → HTTPS (loop-safe для Джино) ───
RewriteCond %{HTTP:X-Forwarded-Proto} =http
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# ─── 2. www → без www ───
RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# ─── 3. Редиректы старых URL конструктора (301) ───
RewriteRule ^blog/(.+?)/?$ /$1/ [R=301,L]
RewriteRule ^(splavy-na-baydarkah|baydarki|katamarany|arenda-baydarki|prokat-baydarki)/?$ /splav-po-dony-na-ploty/ [R=301,L]
RewriteRule ^(auto-trip-volgograd|auto-trip|travel-guide|avtoputeshestviya|lutshie-mesta-dlya-avtoputeshestviya)/?$ /camping/ [R=301,L]
RewriteRule ^(arenda-baidarki-supboard|supboard|sap-doski|arenda-sap)/?$ /camp/ [R=301,L]
RewriteRule ^raiting-camping-russia/?$ /camping/ [R=301,L]
RewriteRule ^(kemping|kemping-vertyachiy|camping-vertyachiy|park-vertyachiy|vertyachiy)/?$ /camp/ [R=301,L]
RewriteRule ^(plot|plot-bulbusik|bulbusik|arenda-plota)/?$ /splav-po-dony-na-ploty/ [R=301,L]
RewriteRule ^(rybalka|rybalka-na-donu)/?$ /fishing-volgograd-oblast/ [R=301,L]

# ─── 4. Ошибки → наша фирменная 404 ───
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html

# ─── 5. Безопасность ───
Options -Indexes
<FilesMatch "(^\.|\.zip$|\.md$|\.envrc$|_bak$)">
  Require all denied
</FilesMatch>

# ─── 6. Кэш статики ───
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# ─── 7. Сжатие (gzip) ───
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/xml text/plain
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/ld+json application/xml image/svg+xml
</IfModule>

# ─── 8. Security-заголовки + no-referrer для фото selstorage ───
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "no-referrer"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ─── 9. MIME-типы ───
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType application/ld+json .json
</IfModule>