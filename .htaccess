# ═══════════════════════════════════════════════════════
# .htaccess rostur.expert · Apache (Jino) · v2026-10-09
# ═══════════════════════════════════════════════════════

RewriteEngine On
DirectoryIndex index.html

# ─── 1. HTTPS-редирект ──────────────────────────────────
# ВНИМАНИЕ: держи этот блок ЗАКОММЕНТИРОВАННЫМ, пока не выпущен
# SSL-сертификат Let's Encrypt в панели Джино. После выпуска —
# убери решки (#) у трёх строк блока.
# RewriteCond %{HTTPS} off [OR]
# RewriteCond %{HTTP_X_FORWARDED_PROTO} !https
# RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# ─── 2. www → без www ───────────────────────────────────
RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# ─── 3. Слэш к папкам: /camp → /camp/ (SEO-critical) ────
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !(.*)/$
RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{1,5}$
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1/ [R=301,L]

# ─── 4. Редиректы старых URL конструктора ───────────────
RewriteRule ^blog/(.*)$ /$1 [R=301,L]
RewriteRule ^(splavy-na-baydarkah|baydarki|katamarany|arenda-baydarki)/?$ /splav-po-dony-na-ploty/ [R=301,L]
RewriteRule ^(auto-trip-volgograd|auto-trip|travel-guide|avtoputeshestviya)/?$ /camping/ [R=301,L]
RewriteRule ^(arenda-baidarki-supboard|supboard|sap-doski)/?$ /camp/ [R=301,L]
RewriteRule ^raiting-camping-russia/?$ /camping/ [R=301,L]
RewriteRule ^(kemping|camping-vertyachiy|park-vertyachiy)/?$ /camp/ [R=301,L]

# ─── 5. Ошибки → наша красивая 404 ──────────────────────
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html

# ─── 6. Запрет листинга папок ────────────────────────────
Options -Indexes

# ─── 7. Защита служебных файлов и архивов ───────────────
<FilesMatch "(^\.|\.zip$|\.md$|\.envrc$)">
  Require all denied
</FilesMatch>

# ─── 8. Кэширование статики (ускорение повторных визитов) ─
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# ─── 9. Сжатие (gzip) ────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/xml application/javascript
  AddOutputFilterByType DEFLATE application/json application/ld+json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ─── 10. Security-заголовки ─────────────────────────────
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ─── 11. MIME-типы ──────────────────────────────────────
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType application/ld+json .json
</IfModule>