# ═══════════════════════════════════════════════════════
# .htaccess для rostur.expert (Apache)
# Обновлено: 2026-10-08
# ═══════════════════════════════════════════════════════

# Включаем движок редиректов
RewriteEngine On

# ─── 1. HTTPS редирект (http → https) ─────────────────
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ─── 2. Убираем www (www → non-www) ───────────────────
RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [L,R=301]

# ─── 3. Добавляем слэш к папкам (SEO-critical!) ───────
# Чтобы /camp → /camp/ (каноникал везде со слэшем)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !(.*)/$
RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{1,5}$
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1/ [L,R=301]

# ─── 4. Главная страница ──────────────────────────────
DirectoryIndex index.html

# ─── 5. Кастомные страницы ошибок ────────────────────
ErrorDocument 404 /index.html
ErrorDocument 403 /index.html

# ─── 6. Кэширование статики (ускоряет сайт в 2-3 раза) ─
<IfModule mod_expires.c>
    ExpiresActive On
    # Изображения — 1 год
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    # CSS и JS — 1 месяц (CDN Tailwind обновится сам)
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    # Шрифты — 1 год
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    # HTML — не кэшировать (всегда свежий)
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# ─── 7. Сжатие (gzip/brotli) ──────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript
    AddOutputFilterByType DEFLATE application/json application/ld+json
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE application/xml text/xml
    AddOutputFilterByType DEFLATE application/x-font-woff font/woff2
</IfModule>

# ─── 8. Security headers ──────────────────────────────
<IfModule mod_headers.c>
    # Защита от встраивания в iframe
    Header set X-Frame-Options "SAMEORIGIN"
    # Защита от XSS и MIME-сниффинга
    Header set X-Content-Type-Options "nosniff"
    Header set X-XSS-Protection "1; mode=block"
    # Referrer Policy
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    # Permissions
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    # Preload HSTS (раскомментируй через месяц работы HTTPS)
    # Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

# ─── 9. Запрет листинга директорий ────────────────────
Options -Indexes

# ─── 10. Защита чувствительных файлов ─────────────────
<FilesMatch "\.(htaccess|htpasswd|ini|log|sh|sql|md)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# ─── 11. MIME-типы для новых форматов ─────────────────
<IfModule mod_mime.c>
    AddType image/webp .webp
    AddType font/woff2 .woff2
    AddType application/ld+json .json
</IfModule>